# Copy this file to .env and fill in real values. Never commit .env.
# .env is already git-ignored at the repo root.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-48-byte-urlsafe-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./carvms.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base URL of the running frontend -- used only to bounce the browser back
# there after the Gmail OAuth callback completes.
FRONTEND_URL=http://localhost:5173

# Email integration (Gmail OAuth) -- see docs/EMAIL_SETUP.md for how to get
# these. Leave blank to run without email features; nothing else breaks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/email/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This one is a LOCAL secret you generate yourself -- not issued by Google.
EMAIL_TOKEN_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key

# Centers Master sheet sync -- optional. CSV export URL of a Google Sheet
# shared as "Anyone with the link -- Viewer": open the sheet -> Share ->
# General access -> Anyone with the link -> Viewer, then use:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
CENTERS_MASTER_SHEET_CSV_URL=

# One-time bootstrap Admin account -- only ever acts if the database has
# zero Admin users yet (e.g. a brand-new deploy with an empty DB). Leave
# blank for normal local dev once you already have an Admin account. Safe
# to leave set permanently -- it's a no-op the moment any Admin exists.
# See docs/DEPLOYMENT.md.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
